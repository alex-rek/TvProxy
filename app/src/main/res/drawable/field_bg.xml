<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/field" /><corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="@color/focus" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/field" /><corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="@color/field" /></shape>
    </item>
</selector>
