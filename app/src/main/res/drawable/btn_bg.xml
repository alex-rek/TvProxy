<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/focus" /><corners android:radius="10dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/focus" /><corners android:radius="10dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/field" /><corners android:radius="10dp" /></shape>
    </item>
</selector>
