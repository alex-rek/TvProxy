<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="32dp">

    <!-- Левая колонка: статус и кнопки -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HTTP / SOCKS5 для выбранных приложений"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/statusDot"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/dot" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/text"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnConnect"
            style="@style/Btn"
            android:layout_marginTop="24dp"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTest"
            style="@style/Btn"
            android:text="Проверить прокси" />

        <TextView
            android:id="@+id/testResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/muted"
            android:textSize="14sp" />
    </LinearLayout>

    <Space
        android:layout_width="24dp"
        android:layout_height="match_parent" />

    <!-- Правая колонка: настройки -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:background="@drawable/panel_bg"
        android:fillViewport="true"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/Label" android:layout_marginTop="0dp" android:text="Тип прокси" />

            <RadioGroup
                android:id="@+id/typeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/typeSocks"
                    style="@style/Choice"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="SOCKS5" />

                <RadioButton
                    android:id="@+id/typeHttp"
                    style="@style/Choice"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="HTTP" />
            </RadioGroup>

            <CheckBox
                android:id="@+id/udpViaSocks"
                style="@style/Choice"
                android:text="UDP через SOCKS5 (игры, звонки, QUIC)" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:orientation="vertical">

                    <TextView style="@style/Label" android:text="Сервер (IP или домен)" />
                    <EditText
                        android:id="@+id/host"
                        style="@style/Field"
                        android:hint="proxy.example.com"
                        android:inputType="textUri" />
                </LinearLayout>

                <Space android:layout_width="12dp" android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/Label" android:text="Порт" />
                    <EditText
                        android:id="@+id/port"
                        style="@style/Field"
                        android:hint="1080"
                        android:inputType="number"
                        android:maxLength="5" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/Label" android:text="Логин (необязательно)" />
                    <EditText
                        android:id="@+id/user"
                        style="@style/Field"
                        android:inputType="text" />
                </LinearLayout>

                <Space android:layout_width="12dp" android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/Label" android:text="Пароль" />
                    <EditText
                        android:id="@+id/pass"
                        style="@style/Field"
                        android:inputType="textPassword" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/Label" android:text="Приложения" />

            <RadioGroup
                android:id="@+id/modeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/modeOnly"
                    style="@style/Choice"
                    android:text="Только выбранные идут через прокси" />

                <RadioButton
                    android:id="@+id/modeExcept"
                    style="@style/Choice"
                    android:text="Все, кроме выбранных" />
            </RadioGroup>

            <Button
                android:id="@+id/btnApps"
                style="@style/Btn" />

            <TextView style="@style/Label" android:text="DNS-сервер" />
            <EditText
                android:id="@+id/dns"
                style="@style/Field"
                android:hint="1.1.1.1"
                android:inputType="textUri" />

            <CheckBox
                android:id="@+id/dnsViaProxy"
                style="@style/Choice"
                android:layout_marginTop="6dp"
                android:text="DNS-запросы через прокси (без утечек)" />

            <CheckBox
                android:id="@+id/autostart"
                style="@style/Choice"
                android:text="Запускать при включении ТВ" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
